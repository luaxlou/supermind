#!/bin/sh

blocked_python='{"attempts":["python3 was not found or could not start"],"code":"python_unavailable","message":"python3 is required to provision Capability Memory","status":"blocked"}'

launcher_path=$0
original_cwd=$PWD
case "$launcher_path" in
    /*) ;;
    *) launcher_path=$PWD/$launcher_path ;;
esac
while [ -L "$launcher_path" ]; do
    launcher_dir=$(CDPATH= cd -P -- "${launcher_path%/*}" 2>/dev/null && pwd -P) || {
        printf '%s\n' '{"attempts":["launcher path resolution failed"],"code":"unsafe_runtime_path","message":"could not resolve the Capability Memory plugin root","status":"blocked"}' >&2
        exit 3
    }
    launcher_target=$(readlink "$launcher_path" 2>/dev/null) || {
        printf '%s\n' '{"attempts":["launcher symlink resolution failed"],"code":"unsafe_runtime_path","message":"could not resolve the Capability Memory plugin root","status":"blocked"}' >&2
        exit 3
    }
    case "$launcher_target" in
        /*) launcher_path=$launcher_target ;;
        *) launcher_path=$launcher_dir/$launcher_target ;;
    esac
done
launcher_dir=$(CDPATH= cd -P -- "${launcher_path%/*}" 2>/dev/null && pwd -P) || {
    printf '%s\n' '{"attempts":["launcher directory resolution failed"],"code":"unsafe_runtime_path","message":"could not resolve the Capability Memory plugin root","status":"blocked"}' >&2
    exit 3
}
plugin_root=$(CDPATH= cd -P -- "$launcher_dir/.." 2>/dev/null && pwd -P) || {
    printf '%s\n' '{"attempts":["plugin root resolution failed"],"code":"unsafe_runtime_path","message":"could not resolve the Capability Memory plugin root","status":"blocked"}' >&2
    exit 3
}
source_root=$plugin_root/src
if ! CDPATH= cd -P -- "$source_root" 2>/dev/null; then
    printf '%s\n' '{"attempts":["plugin source directory is unavailable"],"code":"unsafe_runtime_path","message":"could not enter the trusted Capability Memory source root","status":"blocked"}' >&2
    exit 3
fi

# Bootstrap interpreters must not consult paths or user-site configuration inherited
# from the calling process. The final child receives only the trusted plugin source.
unset PYTHONPATH PYTHONHOME
PYTHONNOUSERSITE=1
export PYTHONNOUSERSITE

if ! command -v python3 >/dev/null 2>&1; then
    printf '%s\n' "$blocked_python" >&2
    exit 3
fi
if ! python3 -I -c 'import sys' >/dev/null 2>&1; then
    printf '%s\n' "$blocked_python" >&2
    exit 3
fi

bootstrap_tmp=$(/usr/bin/mktemp -d "${TMPDIR:-/tmp}/capability-memory-bootstrap.XXXXXX" 2>/dev/null) || {
    printf '%s\n' '{"attempts":["could not allocate bootstrap output capture"],"code":"command_execution_failed","message":"failed to execute Capability Memory","status":"blocked"}' >&2
    exit 3
}
bootstrap_stdout=$bootstrap_tmp/stdout
bootstrap_stderr=$bootstrap_tmp/stderr
cleanup_bootstrap() {
    /bin/rm -f -- "$bootstrap_stdout" "$bootstrap_stderr"
    /bin/rmdir -- "$bootstrap_tmp" 2>/dev/null || true
}
trap cleanup_bootstrap EXIT HUP INT TERM

python3 -I -c '
import fcntl
import hashlib
import json
import os
import shutil
import stat
import subprocess
import sys
import tempfile
from pathlib import Path


def emit(code, message, attempts):
    print(json.dumps({
        "attempts": attempts,
        "code": code,
        "message": message,
        "status": "blocked",
    }, ensure_ascii=False, sort_keys=True, separators=(",", ":")), file=sys.stderr)


COMMANDS = {"init", "discover", "search", "evaluate", "register", "record-use", "inspect", "rebuild", "health"}


class UnsafeRuntimePath(RuntimeError):
    pass


def default_data_home():
    configured = os.environ.get("CODEX_HOME")
    if configured:
        return Path(configured).expanduser().resolve()
    return (Path.home() / ".codex").resolve()


def normalized_launch(arguments, caller_cwd):
    selected = None
    retained = []
    invalid = False
    index = 0
    while index < len(arguments):
        argument = arguments[index]
        if argument in COMMANDS or not argument.startswith("-"):
            retained.extend(arguments[index:])
            break
        if argument == "--data-home":
            if index + 1 >= len(arguments) or arguments[index + 1].startswith("--") or arguments[index + 1] in COMMANDS:
                invalid = True
                retained.extend(arguments[index:])
                break
            selected = arguments[index + 1]
            index += 2
            continue
        if argument.startswith("--data-home="):
            selected = argument.partition("=")[2]
            if not selected:
                invalid = True
                retained.extend(arguments[index:])
                break
            index += 1
            continue
        retained.append(argument)
        index += 1
    if selected is None:
        data_home = default_data_home()
    else:
        selected_path = Path(selected).expanduser()
        if not selected_path.is_absolute():
            selected_path = caller_cwd / selected_path
        data_home = selected_path.resolve()
    if invalid:
        return data_home, ["--data-home", str(data_home), *arguments]
    return data_home, ["--data-home", str(data_home), *retained]


def isolated_environment(source_root):
    environment = os.environ.copy()
    environment.pop("PYTHONHOME", None)
    for name in tuple(environment):
        if name.upper().startswith("PIP_"):
            environment.pop(name, None)
    environment["PYTHONPATH"] = str(source_root)
    environment["PYTHONNOUSERSITE"] = "1"
    return environment


def safe_directory(parent, child):
    parent.mkdir(parents=True, exist_ok=True)
    if parent.is_symlink() or not parent.is_dir():
        raise RuntimeError(f"unsafe runtime parent: {parent}")
    if child.parent != parent:
        raise RuntimeError(f"runtime path escapes its parent: {child}")
    if child.is_symlink():
        raise RuntimeError(f"runtime path must not be a symlink: {child}")
    child.mkdir(exist_ok=True)
    if child.is_symlink() or not child.is_dir():
        raise RuntimeError(f"unsafe runtime directory: {child}")


def safe_regular(path):
    if path.is_symlink():
        raise RuntimeError(f"runtime file must not be a symlink: {path}")
    return path.is_file()


def file_digest(path):
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def expected_venv_owner(memory_root, venv, python):
    return {
        "format": 1,
        "memory_root": str(memory_root),
        "python": str(python),
        "python_sha256": file_digest(python),
        "venv": str(venv),
    }


def validate_venv_python(memory_root, venv, python):
    try:
        metadata = python.lstat()
    except OSError as error:
        raise UnsafeRuntimePath(f"virtual environment python is unavailable: {python}: {error}") from error
    if not stat.S_ISREG(metadata.st_mode):
        raise UnsafeRuntimePath(f"virtual environment python must be a regular file: {python}")
    resolved_venv = venv.resolve(strict=True)
    resolved_python = python.resolve(strict=True)
    if not resolved_python.is_relative_to(resolved_venv):
        raise UnsafeRuntimePath(f"virtual environment python escapes its managed root: {python}")
    marker = venv / ".supermind-owned.json"
    if not safe_regular(marker):
        raise UnsafeRuntimePath(f"virtual environment ownership marker is missing: {marker}")
    try:
        actual = json.loads(marker.read_text(encoding="utf-8"))
    except (OSError, ValueError) as error:
        raise UnsafeRuntimePath(f"virtual environment ownership marker is unreadable: {marker}") from error
    expected = expected_venv_owner(memory_root, venv, python)
    if actual != expected:
        raise UnsafeRuntimePath(f"virtual environment ownership marker is invalid: {marker}")


def write_json_atomic(path, payload):
    descriptor, temporary_name = tempfile.mkstemp(prefix=path.name + "-", dir=path.parent)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
            json.dump(payload, handle, ensure_ascii=False, sort_keys=True, separators=(",", ":"))
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        if path.is_symlink():
            raise RuntimeError(f"managed marker must not be a symlink: {path}")
        os.replace(temporary_name, path)
    finally:
        if os.path.exists(temporary_name):
            os.unlink(temporary_name)


DEPENDENCY_PROBE = """
from importlib import import_module
from importlib.metadata import version

expected = (
    ("fastembed", "fastembed", "0.8.0"),
    ("filelock", "filelock", "3.32.5"),
    ("huggingface-hub", "huggingface_hub", "1.30.0"),
    ("lancedb", "lancedb", "0.38.0"),
)
for distribution, module, wanted in expected:
    actual = version(distribution)
    if actual != wanted:
        raise RuntimeError(f"{distribution}=={actual}, expected {wanted}")
    import_module(module)
"""


def run_venv_child(venv_python, source_root, child_environment, arguments):
    return subprocess.run(
        [str(venv_python), *arguments],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        check=False,
        cwd=source_root,
        env=child_environment,
    )


def result_detail(result):
    return result.stderr.strip() or result.stdout.strip() or f"exit {result.returncode}"


def dependency_failure(memory_root, venv, venv_python, source_root, child_environment):
    result = run_venv_child(
        venv_python,
        source_root,
        child_environment,
        ["-I", "-c", DEPENDENCY_PROBE],
    )
    validate_venv_python(memory_root, venv, venv_python)
    if result.returncode != 0:
        return "locked dependency import/version validation failed", result_detail(result)
    result = run_venv_child(
        venv_python,
        source_root,
        child_environment,
        ["-I", "-m", "pip", "--isolated", "check"],
    )
    validate_venv_python(memory_root, venv, venv_python)
    if result.returncode != 0:
        return "locked dependency consistency check failed", result_detail(result)
    return None


def install_locked_dependencies(
    memory_root,
    venv,
    venv_python,
    source_root,
    child_environment,
    requirements,
):
    result = run_venv_child(
        venv_python,
        source_root,
        child_environment,
        [
            "-I",
            "-m",
            "pip",
            "--isolated",
            "install",
            "--require-hashes",
            "--disable-pip-version-check",
            "-r",
            str(requirements),
        ],
    )
    validate_venv_python(memory_root, venv, venv_python)
    return None if result.returncode == 0 else result_detail(result)


def create_owned_venv(memory_root, venv, venv_python, source_root, child_environment):
    result = subprocess.run(
        [sys.executable, "-I", "-m", "venv", "--copies", str(venv)],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        check=False,
        cwd=source_root,
        env=child_environment,
    )
    if result.returncode != 0 or not venv_python.is_file():
        emit("venv_creation_failed", "failed to create the locked runtime", [result_detail(result)])
        raise SystemExit(3)
    if venv_python.is_symlink():
        raise UnsafeRuntimePath(f"virtual environment python must not be a symlink: {venv_python}")
    write_json_atomic(
        venv / ".supermind-owned.json",
        expected_venv_owner(memory_root, venv, venv_python),
    )


def remove_owned_venv(memory_root, runtime, venv, venv_python):
    validate_venv_python(memory_root, venv, venv_python)
    pending = [venv]
    while pending:
        directory = pending.pop()
        with os.scandir(directory) as entries:
            for entry in entries:
                if entry.is_symlink():
                    raise UnsafeRuntimePath(
                        f"owned virtual environment contains a symlink: {entry.path}"
                    )
                if entry.is_dir(follow_symlinks=False):
                    pending.append(Path(entry.path))
                elif not entry.is_file(follow_symlinks=False):
                    raise UnsafeRuntimePath(
                        f"owned virtual environment contains a special file: {entry.path}"
                    )
    quarantine = Path(tempfile.mkdtemp(prefix=".venv-rebuild-", dir=runtime))
    quarantine.rmdir()
    os.replace(venv, quarantine)
    try:
        shutil.rmtree(quarantine)
    finally:
        if quarantine.exists():
            shutil.rmtree(quarantine, ignore_errors=True)


launcher = Path(sys.argv[1]).resolve(strict=True)
plugin_root = launcher.parent.parent
requirements = plugin_root / "requirements.lock"
source_root = plugin_root / "src"
caller_cwd = Path(sys.argv[2]).resolve(strict=True)
original_arguments = sys.argv[3:]
child_environment = isolated_environment(source_root)

try:
    data_home, arguments = normalized_launch(original_arguments, caller_cwd)
    if data_home.is_symlink():
        raise RuntimeError(f"data home must not be a symlink: {data_home}")
    data_home.mkdir(parents=True, exist_ok=True)
    if not data_home.is_dir():
        raise RuntimeError(f"data home is not a directory: {data_home}")
    supermind_root = data_home / "supermind"
    safe_directory(data_home, supermind_root)
    memory_root = supermind_root / "capability-memory"
    safe_directory(supermind_root, memory_root)
    runtime = memory_root / "runtime"
    safe_directory(memory_root, runtime)
    for owned_name in ("database", "model-cache", "locks", "generations"):
        safe_directory(memory_root, memory_root / owned_name)
    lock_path = runtime / "bootstrap.lock"
    if lock_path.is_symlink():
        raise RuntimeError(f"bootstrap lock must not be a symlink: {lock_path}")
    flags = os.O_CREAT | os.O_RDWR
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    lock_fd = os.open(lock_path, flags, 0o600)
except Exception as error:
    emit("unsafe_runtime_path", str(error), [f"runtime path validation: {error}"])
    raise SystemExit(3)

try:
    with os.fdopen(lock_fd, "w") as lock_handle:
        fcntl.flock(lock_handle.fileno(), fcntl.LOCK_EX)
        venv = runtime / "venv"
        if venv.is_symlink():
            raise UnsafeRuntimePath(f"virtual environment must not be a symlink: {venv}")
        venv_python = venv / "bin" / "python"
        if not venv.exists():
            create_owned_venv(
                memory_root,
                venv,
                venv_python,
                source_root,
                child_environment,
            )
        elif not venv.is_dir():
            raise UnsafeRuntimePath(f"virtual environment is not a directory: {venv}")
        validate_venv_python(memory_root, venv, venv_python)

        digest = hashlib.sha256(requirements.read_bytes()).hexdigest()
        marker = runtime / "requirements.sha256"
        installed_digest = marker.read_text(encoding="utf-8").strip() if safe_regular(marker) else None
        validation_failure = dependency_failure(
            memory_root,
            venv,
            venv_python,
            source_root,
            child_environment,
        )
        matching_marker_was_broken = installed_digest == digest and validation_failure is not None
        if installed_digest != digest or validation_failure is not None:
            if matching_marker_was_broken:
                marker.unlink(missing_ok=True)
                directory_descriptor = os.open(runtime, os.O_RDONLY)
                try:
                    os.fsync(directory_descriptor)
                finally:
                    os.close(directory_descriptor)
            install_failure = install_locked_dependencies(
                memory_root,
                venv,
                venv_python,
                source_root,
                child_environment,
                requirements,
            )
            if install_failure is None:
                validation_failure = dependency_failure(
                    memory_root,
                    venv,
                    venv_python,
                    source_root,
                    child_environment,
                )
            if matching_marker_was_broken and (
                install_failure is not None or validation_failure is not None
            ):
                remove_owned_venv(memory_root, runtime, venv, venv_python)
                create_owned_venv(
                    memory_root,
                    venv,
                    venv_python,
                    source_root,
                    child_environment,
                )
                validate_venv_python(memory_root, venv, venv_python)
                install_failure = install_locked_dependencies(
                    memory_root,
                    venv,
                    venv_python,
                    source_root,
                    child_environment,
                    requirements,
                )
                validation_failure = None
                if install_failure is None:
                    validation_failure = dependency_failure(
                        memory_root,
                        venv,
                        venv_python,
                        source_root,
                        child_environment,
                    )
            if install_failure is not None:
                emit(
                    "dependency_install_failed",
                    "failed to install locked dependencies",
                    [install_failure],
                )
                raise SystemExit(3)
            if validation_failure is not None:
                message, detail = validation_failure
                emit("dependency_validation_failed", message, [detail])
                raise SystemExit(3)
            descriptor, temporary_name = tempfile.mkstemp(prefix="requirements-", dir=runtime)
            try:
                with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
                    handle.write(digest + "\n")
                    handle.flush()
                    os.fsync(handle.fileno())
                if marker.is_symlink():
                    raise RuntimeError(f"requirements marker must not be a symlink: {marker}")
                os.replace(temporary_name, marker)
            finally:
                if os.path.exists(temporary_name):
                    os.unlink(temporary_name)
        validate_venv_python(memory_root, venv, venv_python)
        fcntl.flock(lock_handle.fileno(), fcntl.LOCK_UN)

    runner = (
        "import runpy,sys;"
        "source=sys.argv.pop(1);"
        "sys.path.insert(0,source);"
        "sys.argv[0]=\"capability-memory\";"
        "runpy.run_module(\"supermind_memory.cli\",run_name=\"__main__\")"
    )
    result = subprocess.run(
        [str(venv_python), "-I", "-c", runner, str(source_root), *arguments],
        stdin=None,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        check=False,
        cwd=source_root,
        env=child_environment,
    )
    if result.returncode == 0 and not result.stderr:
        sys.stdout.write(result.stdout)
        raise SystemExit(0)
    if result.returncode in (2, 3) and not result.stdout:
        try:
            payload = json.loads(result.stderr)
        except (TypeError, ValueError):
            payload = None
        expected_status = "invalid" if result.returncode == 2 else "blocked"
        if isinstance(payload, dict) and payload.get("status") == expected_status:
            sys.stderr.write(result.stderr)
            raise SystemExit(result.returncode)
    detail = result.stderr.strip() or result.stdout.strip() or f"exit {result.returncode}"
    emit("command_execution_failed", "failed to execute Capability Memory", [detail])
    raise SystemExit(3)
except SystemExit:
    raise
except UnsafeRuntimePath as error:
    emit("unsafe_runtime_path", str(error), [f"runtime path validation: {error}"])
    raise SystemExit(3)
except Exception as error:
    emit("command_execution_failed", "failed to execute Capability Memory", [f"{type(error).__name__}: {error}"])
    raise SystemExit(3)
' "$launcher_path" "$original_cwd" "$@" >"$bootstrap_stdout" 2>"$bootstrap_stderr"

status=$?
if [ "$status" -eq 0 ] || [ "$status" -eq 2 ] || [ "$status" -eq 3 ]; then
    /bin/cat -- "$bootstrap_stdout"
    /bin/cat -- "$bootstrap_stderr" >&2
else
    printf '%s\n' '{"attempts":["python3 command execution failed"],"code":"python_unavailable","message":"python3 could not execute the Capability Memory bootstrap","status":"blocked"}' >&2
    status=3
fi
cleanup_bootstrap
trap - EXIT HUP INT TERM
exit "$status"
