#!/bin/sh
# Isolate the standard-library bootstrap from the caller's Python environment.
launcher=$0
case "$launcher" in /*) ;; *) launcher=$PWD/$launcher ;; esac
while [ -L "$launcher" ]; do
    directory=$(CDPATH= cd -P -- "${launcher%/*}" && pwd -P) || exit 3
    target=$(readlink "$launcher") || exit 3
    case "$target" in /*) launcher=$target ;; *) launcher=$directory/$target ;; esac
done
directory=$(CDPATH= cd -P -- "${launcher%/*}" && pwd -P) || exit 3
unset PYTHONPATH PYTHONHOME
export PYTHONNOUSERSITE=1
if ! command -v python3 >/dev/null 2>&1; then
    printf '%s\n' '{"status":"blocked","code":"python_unavailable","message":"python3 is required to provision Capability Memory"}' >&2
    exit 3
fi
exec python3 -I "$directory/bootstrap.py" "$@"
